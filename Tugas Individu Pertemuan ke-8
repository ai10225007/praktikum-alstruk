        "# ==============================================================================\n",
        "# TUGAS PERTEMUAN 8 - ALGORITMA DAN STRUKTUR DATA\n",
        "# Nama  : Ai Asri Astiani\n",
        "# NIM   : 10225007\n",
        "# Prodi : Teknik Informatika\n",
        "# Studi Kasus: Sistem Kasir & Antrean Pesanan Kedai Kopi\n",
        "# ==============================================================================\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 1. IMPLEMENTASI ARRAY (1 DIMENSI & 2 DIMENSI)\n",
        "# Digunakan untuk daftar harga menu dan keranjang belanja (bisa ditambah/diubah)\n",
        "# ------------------------------------------------------------------------------\n",
        "print(\"=== 1. IMPLEMENTASI ARRAY (MENU & KERANJANG PESANAN) ===\")\n",
        "\n",
        "# A. Array 1 Dimensi (1 baris data harga minuman)\n",
        "daftar_harga = [15000, 18000, 20000, 12000]\n",
        "print(f\"Array 1D (Harga Awal)      : {daftar_harga}\")\n",
        "\n",
        "# Manipulasi Array 1D (Mengubah harga ke-0 dan menambah menu baru)\n",
        "daftar_harga[0] = 16000\n",
        "daftar_harga.append(22000)\n",
        "print(f\"Array 1D (Setelah Diubah)  : {daftar_harga}\\n\")\n",
        "\n",
        "# B. Array 2 Dimensi (Beberapa baris & kolom: [Nama Menu, Harga, Jumlah Beli])\n",
        "keranjang_pesanan = [\n",
        "    [\"Kopi Susu Gula Aren\", 18000, 2],\n",
        "    [\"Matcha Latte\", 20000, 1],\n",
        "    [\"Roti Bakar Coklat\", 15000, 2],\n",
        "    [\"Kentang Goreng\", 16000, 1]\n",
        "]\n",
        "\n",
        "print(\"Array 2D (Isi Keranjang Pesanan):\")\n",
        "total_bayar = 0\n",
        "for i in range(len(keranjang_pesanan)):\n",
        "    menu = keranjang_pesanan[i][0]\n",
        "    harga = keranjang_pesanan[i][1]\n",
        "    qty = keranjang_pesanan[i][2]\n",
        "    subtotal = harga * qty\n",
        "    total_bayar += subtotal\n",
        "    print(f\"  Baris {i} -> {menu:<20} | {qty} x Rp{harga} = Rp{subtotal}\")\n",
        "\n",
        "# Mengubah jumlah beli pada Baris 1 Kolom 2 (Matcha Latte jadi 2 gelas)\n",
        "keranjang_pesanan[1][2] = 2\n",
        "total_bayar = sum(item[1] * item[2] for item in keranjang_pesanan)\n",
        "print(f\"Update Array 2D [Baris 1][Kolom 2] -> Total Akhir: Rp{total_bayar}\\n\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 2. IMPLEMENTASI LINKED LIST (SINGLY LINKED LIST)\n",
        "# Digunakan untuk sistem antrean pembuatan pesanan oleh barista\n",
        "# ------------------------------------------------------------------------------\n",
        "print(\"=== 2. IMPLEMENTASI SINGLY LINKED LIST (ANTREAN PESANAN) ===\")\n",
        "\n",
        "class Node:\n",
        "    def __init__(self, no_antrean, nama_pelanggan):\n",
        "        self.no_antrean = no_antrean\n",
        "        self.nama_pelanggan = nama_pelanggan\n",
        "        self.next = None  # Pointer mengarah ke node berikutnya\n",
        "\n",
        "class AntreanKafe:\n",
        "    def __init__(self):\n",
        "        self.head = None  # Titik awal antrean\n",
        "\n",
        "    # Menambah antrean di belakang (node baru terhubung ke node terakhir)\n",
        "    def masuk_antrean(self, no_antrean, nama_pelanggan):\n",
        "        node_baru = Node(no_antrean, nama_pelanggan)\n",
        "        if self.head is None:\n",
        "            self.head = node_baru\n",
        "            return\n",
        "\n",
        "        sekarang = self.head\n",
        "        while sekarang.next:\n",
        "            sekarang = sekarang.next\n",
        "        sekarang.next = node_baru\n",
        "\n",
        "    # Menyelesaikan antrean paling depan (head bergeser ke node berikutnya)\n",
        "    def selesaikan_pesanan(self):\n",
        "        if self.head is None:\n",
        "            print(\"Antrean kosong.\")\n",
        "            return\n",
        "        selesai = self.head\n",
        "        self.head = self.head.next\n",
        "        print(f\"Pesanan Selesai : [{selesai.no_antrean} - {selesai.nama_pelanggan}]\")\n",
        "\n",
        "    # Menampilkan jalur pointer dari head sampai akhir\n",
        "    def tampilkan_antrean(self):\n",
        "        sekarang = self.head\n",
        "        urutan = []\n",
        "        while sekarang:\n",
        "            urutan.append(f\"[{sekarang.no_antrean}: {sekarang.nama_pelanggan}]\")\n",
        "            sekarang = sekarang.next\n",
        "        print(\"Jalur Pointer   : \" + \" -> \".join(urutan) + \" -> None\")\n",
        "\n",
        "# Eksekusi Linked List\n",
        "antrean = AntreanKafe()\n",
        "antrean.masuk_antrean(\"A01\", \"Ai Asri Astiani\")\n",
        "antrean.masuk_antrean(\"A02\", \"Nadia\")\n",
        "antrean.masuk_antrean(\"A03\", \"Rizky\")\n",
        "antrean.masuk_antrean(\"A04\", \"Dimas\")\n",
        "\n",
        "antrean.tampilkan_antrean()\n",
        "antrean.selesaikan_pesanan()\n",
        "antrean.tampilkan_antrean()\n",
        "print()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# 3. IMPLEMENTASI TUPLE (DATA STATIS / PERMANEN)\n",
        "# Digunakan untuk identitas kasir & struk final agar tidak bisa dimanipulasi\n",
        "# ------------------------------------------------------------------------------\n",
        "print(\"=== 3. IMPLEMENTASI TUPLE (DATA KASIR & STRUK PERMANEN) ===\")\n",
        "\n",
        "# Tuple menggunakan tanda kurung (), akses indeks dari 0, bersifat immutable\n",
        "info_kasir = (\"10225007\", \"Ai Asri Astiani\", \"Teknik Informatika\", \"Shift Pagi\")\n",
        "kategori_pesanan = (\"Kopi\", \"Non-Kopi\", \"Makanan\", \"Makanan\", \"Non-Kopi\")\n",
        "\n",
        "# Struk final dikunci dalam Tuple agar nominal tidak bisa diubah setelah dibayar\n",
        "struk_final = (info_kasir[1], \"A01\", total_bayar, \"LUNAS\")\n",
        "\n",
        "print(f\"NIM Kasir        : {info_kasir[0]}\")\n",
        "print(f\"Nama Kasir       : {info_kasir[1]}\")\n",
        "print(f\"Prodi / Shift    : {info_kasir[2]} ({info_kasir[3]})\")\n",
        "print(f\"Kategori Menu    : {kategori_pesanan}\")\n",
        "print(f\"Total Kategori (len)             : {len(kategori_pesanan)} item\")\n",
        "print(f\"Jumlah Kategori 'Makanan' (count): {kategori_pesanan.count('Makanan')} kali\")\n",
        "print(f\"Struk Final (Tuple)              : {struk_final}\")\n",
        "print(\"Status Tuple     : Aman (Data permanen, tidak dapat diubah setelah dibuat)\")"
      ]
    }
  ]
